#define DEFAULT 0
#define NUM     1
#define SYM     2
#define FUN     3
#define MOUSE   4
#define SCROLL  5
#define SNIPE   6

#include <behaviors/mouse_keys.dtsi>
#include <dt-bindings/zmk/mouse.h>
#include <dt-bindings/zmk/runtime_input_processor.h>
#include <dt-bindings/input/input-event-codes.h>

#include <behaviors/runtime-input-processor.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&lt {
    tapping-term-ms = <240>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

&mt {
    tapping-term-ms = <200>;
    flavor = "tap-preferred";
    quick-tap-ms = <150>;
};

&caps_word { continue-list = <UNDERSCORE MINUS>; };

/ {
    // custom shift using mod-morph 

    behaviors {
        cmqus: comma_question {
            compatible = "zmk,behavior-mod-morph";
            label = "COMMA_QUESTION";
            #binding-cells = <0>;
            bindings = <&kp COMMA>, <&kp QUESTION>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        dtsmi: dot_semi {
            compatible = "zmk,behavior-mod-morph";
            label = "DOT_SEMI";
            #binding-cells = <0>;
            bindings = <&kp DOT>, <&kp SEMI>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    macros {
        bd: bd {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp N8 &kp N2 &kp N0 &kp N2 &kp N0 &kp N5 &kp N0 &kp N0>;
            label = "BD";
        };

        Hy: Hy {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(H) &kp Y &kp LS(D) &kp R &kp O &kp LS(G) &kp E &kp N &kp N2 &kp N5 &kp N2 &kp N8>;
            label = "HY";
        };

        p1: p1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(U) &kp RPAR &kp CARET &kp R &kp M &kp P &kp N4 &kp D &kp N9 &kp N3>;
            label = "P1";
        };

        p2: p2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(U) &kp N0 &kp N6 &kp R &kp M &kp P &kp N4 &kp D &kp N9 &kp N3>;
            label = "P2";
        };

        p3: p3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp U &kp N0 &kp N6 &kp R &kp M &kp P &kp N4 &kp D &kp N9 &kp N3>;
            label = "P3";
        };

        id: id {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(N) &kp N1 &kp N2 &kp N4 &kp N8 &kp N1 &kp N2 &kp N9 &kp N3 &kp N3>;
            label = "ID";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            label = "QWER";
            bindings = <
&kp Q             &kp W           &kp E        &kp R           &kp T                                      &kp Y            &kp U            &kp I        &kp O            &kp P
&mt LEFT_SHIFT A  &mt LEFT_ALT S  &mt LCTRL D  &mt LEFT_GUI F  &kp G                                      &kp H            &mt RIGHT_GUI J  &mt RCTRL K  &mt RIGHT_ALT L  &mt RIGHT_SHIFT SEMI
&kp Z             &kp X           &kp C        &kp V           &kp B                                      &kp N            &kp M            &kp COMMA    &kp DOT          &kp SLASH
&kp LCTRL         &kp LEFT_WIN    &kp LALT     &lt 6 ESCAPE    &lt 4 SPACE  &lt 5 LA(GRAVE)  &lt 2 SPACE  &lt 1 BACKSPACE                                                 &kp RSHFT
            >;
        };

        number_layer {
            label = "Num&Ar";
            bindings = <
&p1  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp HOME                  &kp PG_UP      &none           &kp UP_ARROW    &none            &none
&p2  &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp END                   &kp PAGE_DOWN  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &none
&p3  &kp N7        &kp N8        &kp N9        &kp N0                    &mkp LCLK      &mkp MCLK       &mkp RCLK       &trans           &none
&Hy  &id           &bd           &trans        &trans    &trans  &trans  &trans                                                          &kp LC(LA(DELETE))
            >;
        };

        symbol_layer {
            label = "SYM";
            bindings = <
&kp EXCLAMATION  &kp AT_SIGN  &kp HASH   &kp DOLLAR    &kp PERCENT                  &kp CARET       &kp AMPERSAND  &kp ASTERISK      &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS
&none            &none        &none      &none         &trans                       &kp MINUS       &kp EQUAL      &kp LEFT_BRACKET  &kp RIGHT_BRACKET     &kp SQT
&kp EQUAL        &kp PLUS     &kp MINUS  &kp ASTERISK  &kp SLASH                    &kp UNDERSCORE  &kp PLUS       &trans            &trans                &kp NON_US_BACKSLASH
&trans           &trans       &trans     &trans        &trans       &trans  &trans  &trans                                                                 &trans
            >;
        };

        function_layer {
            label = "F&Bt";
            bindings = <
&kp F1   &kp F2   &kp F3  &kp F4  &kp F5                   &studio_unlock  &none         &none         &none         &bt BT_CLR
&kp F6   &kp F7   &kp F8  &kp F9  &kp F10                  &bt BT_SEL 0    &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&kp F11  &kp F12  &none   &none   &none                    &none           &none         &none         &none         &none
&trans   &trans   &trans  &trans  &trans   &trans  &trans  &trans                                                    &trans
            >;
        };

        mouse_layer {
            label = "MOUSE";
            bindings = <
&kp N1          &kp N2          &kp N3        &kp N4     &kp N5                    &kp N6         &kp N7     &kp N8     &kp N9     &kp N0
&kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT  &kp HOME                  &kp PAGE_UP    &mkp LCLK  &mkp MCLK  &mkp RCLK  &none
&none           &none           &none         &none      &kp END                   &kp PAGE_DOWN  &none      &none      &none      &none
&none           &trans          &trans        &trans     &trans    &trans  &trans  &mo 3                                           &none
            >;
        };

        scroll_layer {
            label = "SCROLL";
            bindings = <
&trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans                          &trans
            >;
        };

        snipe_layer {
            label = "SNIPE";
            bindings = <
&trans  &trans  &trans  &trans  &bootloader                  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                       &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                       &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans       &trans  &trans  &trans                          &trans
            >;
        };
    };
};

&trackball { cpi = <800>; };
